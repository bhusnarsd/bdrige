<%- include('../partials/header') %>
    <div class="container">
        <%- include('../partials/left-panel') %>
            <div class="right-panel">

                <div class="banner">
                    <img src="images/banner-img.jpg" alt="Logo">
                </div>
                <div class="content-area">
                    <div class="breadcrumbs">
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li>Warning List</li>
                        </ul>
                    </div>
                    <div class="search-area">
                        <h2>WARNING LIST</h2>
                        <div class="search-box">
                            <!-- Search Form -->
                            <form method="get" action="/staff/confidentiality-contract/list">
                                <div class="search-form">
                                    <input type="text" name="search" value="<%= searchTerm %>"
                                        placeholder="Search by staff name">
                                </div>
                                <div class="form-group button-group">
                                    <button type="submit">Search</button>&nbsp;
                                    <button type="button" id="reset-button">Reset</button>
                                </div>
                            </form>
                            <a href="/staff/confidentiality-contract">Add Staff Confidentiality Contract</a>
                            <div class="tablewrapper">
                                <div class="table-responsive">
                                    <table class="table table-condensed table-striped">
                                        <thead class="tablehead">
                                            <tr>
                                                <th>Staff ID</th>
                                                <th>Staff Name</th>
                                                <th>Date of issue</th>
                                                <th>Department</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody class="tablebody">
                                            <% staffList.forEach(staff=> { %>
                                                <tr>
                                                    <td><%= staff.StaffDetail.staff_id %></td>
                                                    <td><%= staff.StaffDetail.staff_name %></td>
                                                    <td><%= staff.doi %></td>
                                                    <td><%= staff.Department ? staff.Department.name : '' %></td>
                                                    <td><a href="/confidentiality-contract/edit/<%= staff.id %>">Edit</a> | Delete</td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <!-- Pagination -->
                            <div class="pagination">
                                <ul>
                                    <% for (let i=1; i <=totalPages; i++) { %>
                                        <li><a href="/staff?page=<%= i %>&search=<%= searchTerm %>">
                                                <%= i %>
                                            </a></li>
                                        <% } %>
                                </ul>
                            </div>
                            <!-- Download Buttons -->
                            <div class="download">
                                <a href="/export/excel?search=<%= searchTerm %>">Download as Excel</a> |
                                <a href="/export/pdf?search=<%= searchTerm %>">Download as PDF</a>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
    </div>
    <script>
        $(document).ready(function () {
            $('#reset-button').click(function () {
                // Reset the search input field
                $('input[name="search"]').val('');

                // Optionally, submit the form to trigger a reset-like behavior
                $('form').submit();
            });
        });
    </script>
    <%- include('../partials/footer') %>