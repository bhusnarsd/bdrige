      //   Object.keys(sectionMap).forEach(section => {
      //     const isActive = document.querySelector(`input[name="${section}"]:checked`)?.value === "1";
      //     const prefix = sectionMap[section];
      //     const fileInput = document.getElementById(`${prefix}_file`);
      //     const dateInput =
      //       document.getElementById(`${prefix}_expiry`) ||
      //       document.getElementById(`${prefix}_date`) ||
      //       document.querySelector(`[id^="${prefix}_"][type="date"]`);

      //     if (isActive) {
      //       if (fileInput && fileInput.files.length === 0 && !fileInput.hasAttribute("data-existing")) {
      //         isValid = false;
      //       }
      //       if (dateInput && dateInput.value.trim() === "") {
      //         isValid = false;
      //       }
      //     }
      //   });

      //   if (!isValid) {
      //     e.preventDefault();
      //     alert("Please upload files and fill dates for all active fields.");
      //   } else {

      //   }
      // });

      // Form submission and loader
      const form = document.querySelector("form");

      form.addEventListener("submit", function (e) {
        let isValid = true;

        Object.keys(sectionMap).forEach(section => {
          const isActive = document.querySelector(`input[name="${section}"]:checked`)?.value === "1";
          const prefix = sectionMap[section];
          const fileInput = document.getElementById(`${prefix}_file`);
          const dateInput =
            document.getElementById(`${prefix}_expiry`) ||
            document.getElementById(`${prefix}_date`) ||
            document.querySelector(`[id^="${prefix}_"][type="date"]`);

          if (isActive) {
            if (fileInput && fileInput.files.length === 0 && !fileInput.hasAttribute("data-existing")) {
              isValid = false;
            }
            if (dateInput && dateInput.value.trim() === "") {
              isValid = false;
            }
          }
        });

        if (!isValid) {
          e.preventDefault();
          alert("Please upload files and fill dates for all active fields.");
        } else {
          const submitBtn = document.getElementById("submitBtn");
          submitBtn.disabled = true;
          submitBtn.classList.add("loading");

          // Optional: add spinner inside the button
          const spinner = document.createElement("span");
          spinner.className = "spinner";
          submitBtn.appendChild(spinner);
        }
      });
    })
  </script>

