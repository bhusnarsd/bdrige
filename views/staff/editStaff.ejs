  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sectionMap = {
        passport: 'passport',
        visa: 'visa',
        experience: 'exp_letter',
        license: 'license',
        emirates_id: 'emirates_id',
        hepatitis_b: 'hepatitis_b',
        bls: 'bls',
        hdc: 'hdc',
        dhacda_license: 'dhacda_license',
        employment_contract: 'employment_contract',
        confidentiality_contract: 'confidentiality_contract',
        employee_handbook: 'employee_handbook',
        dhacda_policies: 'dhacda_policies'
      };

      function disableInactiveFieldsOnLoad() {
        Object.keys(sectionMap).forEach(section => {
          const prefix = sectionMap[section];
          const isActive = document.querySelector(`input[name="${section}"]:checked`)?.value === "1";

          const fileInput = document.getElementById(`${prefix}_file`);
          const dateInput =
            document.getElementById(`${prefix}_expiry`) ||
            document.getElementById(`${prefix}_date`) ||
            document.querySelector(`[id^="${prefix}_"][type="date"]`);
          const viewLink = document.querySelector(`a[href*="${prefix}"]`);

          if (fileInput) {
            fileInput.disabled = !isActive;
            fileInput.style.display = isActive ? 'inline-block' : 'none';
          }

          if (dateInput) {
            dateInput.disabled = !isActive;
          }

          if (viewLink) {
            viewLink.style.display = isActive ? 'inline-block' : 'none';
          }
        });
      }

      function handleToggle(sectionName) {
        const prefix = sectionMap[sectionName];
        const isActive = document.querySelector(`input[name="${sectionName}"]:checked`)?.value === "1";

        const fileInput = document.getElementById(`${prefix}_file`);
        const dateInput =
          document.getElementById(`${prefix}_expiry`) ||
          document.getElementById(`${prefix}_date`) ||
          document.querySelector(`[id^="${prefix}_"][type="date"]`);
        const viewLink = document.querySelector(`a[href*="${prefix}"]`);

        if (fileInput) {
          fileInput.disabled = !isActive;
          fileInput.style.display = isActive ? 'inline-block' : 'none';
        }

        if (dateInput) {
          dateInput.disabled = !isActive;
        }

        if (viewLink) {
          viewLink.style.display = isActive ? 'inline-block' : 'none';
        }
      }

      // On DOM load
      disableInactiveFieldsOnLoad();

      Object.keys(sectionMap).forEach(section => {
        document.querySelectorAll(`input[name="${section}"]`).forEach(radio => {
          radio.addEventListener("change", () => handleToggle(section));
        });
      });

      // Date validations
      const today = new Date().toISOString().split("T")[0];
      document.querySelectorAll("input[type='date']").forEach(dateInput => {
        if (dateInput.id !== "dob") {
          dateInput.setAttribute("min", today);
        }
      });
      const yesterday = new Date();
      yesterday.setDate(yesterday.getDate() - 1);
      const maxDob = yesterday.toISOString().split("T")[0];
      const dobInput = document.getElementById("dob");
      if (dobInput) {
        dobInput.setAttribute("max", maxDob);
      }

      // File name handling
      document.querySelectorAll('.file-wrapper').forEach(wrapper => {
        const fileInput = wrapper.querySelector('input[type="file"]');
        const fileNameSpan = wrapper.querySelector('.file-name');

        fileInput.addEventListener('change', () => {
          if (fileInput.files.length > 0) {
            const name = fileInput.files[0].name;
            fileNameSpan.textContent = name;
            fileNameSpan.style.display = 'inline-block';
            fileInput.style.display = 'none';
          }
        });
      });

      //       // Form submission and loader
      //       const form = document.querySelector("form");
      //       const loader = document.getElementById("formLoader");

      //       // if (form && loader) {
      //         form.addEventListener("submit", function (e) {
