<%- include('../partials/header') %>
  <div class="container">
    <%- include('../partials/left-panel') %>
      <div class="right-panel">
        <div class="content-area">
          <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
            <div style="color: red; margin-bottom: 20px;">
              <%= errorMessage %>
            </div>
            <% } %>
              <% if (typeof successMessage !=='undefined' && successMessage) { %>
                <div style="color: green; margin-bottom: 20px;">
                  <%= successMessage %>
                </div>
                <% } %>

                  <div class="breadcrumbs">
                    <ul>
                      <li><a href="/">Home</a></li>
                      <li><a href="/staff">Staff</a></li>
                      <li>Induction Program</li>
                    </ul>
                  </div>
                  <div class="form-area">
                    <h2>Staff Induction Program</h2>
                    <div class="form-box">
                      <form action="/submit" method="POST">
                        <div class="form-row">
                          <div class="form-group">
                            <label for="staff_id">Unique ID</label>
                            <select id="staff_id" name="staff_id" required>
                              <option value="">-- Select Unique ID --</option>
                              <% if (staffList && staffList.length) { %>
                                <% staffList.forEach(staff=> { %>
                                  <option value="<%= staff.staff_id %>">
                                    <%= staff.staff_id %>
                                  </option>
                                  <% }) %>
                                    <% } else { %>
                                      <option value="">No staff found</option>
                                      <% } %>
                            </select>
                          </div>
                          <div class="form-group">
                            <label for="last-name">Employee Name:</label>
                            <input type="text" id="last-name" name="last-name" placeholder="last name" required>
                          </div>
                        </div>
                        <div class="form-row">
                          <div class="form-group">
                            <label for="email">Department</label>
                            <input type="text" id="last-name" name="last-name" placeholder="last name" required>
                          </div>
                          <div class="form-group">
                            <label for="phone">Job Title</label>
                            <input type="text" id="last-name" name="last-name" placeholder="last name" required>
                          </div>
                        </div>
                        <p>This is a checklist of information for Induction which HR Officer/supervisors should use with
