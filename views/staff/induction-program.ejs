  <script>
    document.getElementById('staff_id').addEventListener('change', async function () {
      const staffId = this.value;
      if (!staffId) {
        document.getElementById('staff_name').value = '';
        return;
      }
      try {
        const res = await fetch('/staff/get-staff-details', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ staff_id: staffId })
        });
        const data = await res.json();
        if (data && data.staff && data.staff.staff_name) {
          document.getElementById('staff_name').value = data.staff.staff_name;
        } else {
          document.getElementById('staff_name').value = '';
          alert('Staff not found.');
        }
      } catch (error) {
        console.error('Error fetching staff details:', error);
        alert('Server error occurred.');
      }
    });
    const randomNumber = Math.floor(Math.random() * 9000 + 1000);
    document.getElementById('staff_name').addEventListener('input', function () {
      // Get the staff_name value
      const staffName = this.value.trim();

      // Check if the name has at least two words (first and last name)
      const nameParts = staffName.split(' ');

      if (nameParts.length >= 2) {
        // Extract the first name and last name
        const firstName = nameParts[0];
        const lastName = nameParts[1];

        // Generate the staff_id
        const staffId = firstName.slice(0, 2).toUpperCase() + lastName.slice(0, 2).toUpperCase() + randomNumber; // Random 4-digit number

        // Set the staff_id value to the generated ID
        document.getElementById('staff_id').value = staffId;
      } else {
        document.getElementById('staff_id').value = '';
      }
    });
  </script>
