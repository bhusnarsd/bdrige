  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Grab elements once
      const staffIdEl   = document.getElementById('staff_id');
      const staffNameEl = document.getElementById('staff_name');
      const form        = document.querySelector('form');
  
      if (staffIdEl && staffNameEl) {
        // When staff_id changes, fetch the name
        staffIdEl.addEventListener('change', async () => {
          const staffId = staffIdEl.value.trim();
          staffNameEl.value = '';
          if (!staffId) return;
  
          try {
            const res  = await fetch('/staff/get-staff-details', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ staff_id: staffId })
            });
            const data = await res.json();
            if (data?.staff?.staff_name) {
              staffNameEl.value = data.staff.staff_name;
            } else {
              alert('Staff not found.');
            }
          } catch (err) {
            console.error('Error fetching staff details:', err);
            alert('Server error occurred.');
          }
        });
  
        // Generate a random suffix once per page load
        const randomSuffix = Math.floor(Math.random() * 9000 + 1000);
        // When name input changes, auto‑generate an ID
        staffNameEl.addEventListener('input', () => {
          const parts = staffNameEl.value.trim().split(' ');
          if (parts.length >= 2) {
            const [first, last] = parts;
            staffIdEl.value = 
              first.slice(0,2).toUpperCase() +
              last.slice(0,2).toUpperCase() +
              randomSuffix;
          } else {
            staffIdEl.value = '';
          }
        });
      }
  
      // Optional: ensure form actually submits
      if (form) {
        form.addEventListener('submit', e => {
          // If you want to block submission when staff_name is empty:
          if (staffNameEl && !staffNameEl.value.trim()) {
            e.preventDefault();
            alert('Please select a valid staff before submitting.');
          }
          // Otherwise, do nothing and allow submit
        });
      }
    });
  </script>
  
