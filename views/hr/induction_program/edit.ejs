<%- include('../../partials/header') %>
<div class="container">
  <%- include('../../partials/left-panel') %>
  <div class="right-panel">
    <div class="content-area">
      <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
        <div style="color: red; margin-bottom: 20px;"><%= errorMessage %></div>
      <% } %>
      <% if (typeof successMessage !=='undefined' && successMessage) { %>
        <div style="color: green; margin-bottom: 20px;"><%= successMessage %></div>
      <% } %>
      <div class="breadcrumbs">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/staff">Staff</a></li>
          <li>Edit Induction Program</li>
        </ul>
      </div>
      <div class="form-area">
        <h2>Edit Staff Induction Program</h2>
        <div class="form-box">
          <form action="/hr/sip/edit/<%= induction.id %>" method="POST">
            <div class="form-row">
                <div class="form-group">
                    <label for="staff_id">Unique id:</label>
                    <input type="text" id="staff_id" name="staff_id" value="<%= induction.StaffDetail ? induction.StaffDetail.staff_id : '' %>" readonly>
                    <!-- <input type="hidden" id="staff_id" name="staff_id" value="<%= induction.StaffDetail ? induction.StaffDetail.id : '' %>"> -->
                  </div>
 
              <div class="form-group">
                <label for="staff_name">Employee Name</label>
                <input type="text" id="staff_name" name="staff_name" value="<%=  induction.StaffDetail ? induction.StaffDetail.staff_name : ''%>" readonly>
              </div>
            </div>
            <div class="form-row"> 
              <div class="form-group">
                <label for="dept">Department</label>
                <select id="dept" name="dept" required>
                  <option value="">-- Select Department --</option>
                  <% let departments = [
                    "Clinic Manager", "Speech Therapist", "OT", "Physiotherapist", "ABA",
                    "ABA Supervisor", "Psychologist", "Intern-Speech Therapist", "Light Vehicle Driver",
                    "Cleaner", "Admin", "Driver", "Marketing Executive", "Marketing Manager"
                  ]; %>
                  <% departments.forEach(dep => { %>
                    <option value="<%= dep %>" <%= dep === induction.dept ? 'selected' : '' %>><%= dep %></option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label for="job_title">Job Title</label>
                <input type="text" id="job_title" name="job_title" value="<%= induction.job_title %>" required>
              </div>
            </div>

