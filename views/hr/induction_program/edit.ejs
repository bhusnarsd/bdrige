<script>
    document.addEventListener('DOMContentLoaded', () => {
      const staffIdInput = document.getElementById('staff_id');
      const staffNameInput = document.getElementById('staff_name');
      const departmentInput = document.getElementById('department');
  // Client-side JavaScript to format and populate date fields
function formatDateForInput(isoString) {
    if (!isoString) return '';
    const date = new Date(isoString);
    return date.toISOString().split('T')[0]; // Returns YYYY-MM-DD
}

// When loading the form, set the date input values
document.addEventListener('DOMContentLoaded', () => {
    // For each date field in your form
    const dateFields = {
        emp_sign_date: yourData.emp_sign_date,
        sid_sparty_date: yourData.sid_sparty_date
        // Add other date fields as needed
    };

    for (const [fieldId, dateValue] of Object.entries(dateFields)) {
        const inputElement = document.getElementById(fieldId);
        if (inputElement) {
            inputElement.value = formatDateForInput(dateValue);
        }
    }
});
      // Load staff name and department if staff_id changes
      staffIdInput.addEventListener('change', async () => {
        const staffId = staffIdInput.value;
        if (!staffId) {
          staffNameInput.value = '';
          departmentInput.value = '';
          return;
        }
  
        try {
          const res = await fetch(`/api/staff/${staffId}`);
          if (!res.ok) throw new Error('Failed to fetch staff data');
          const data = await res.json();
          staffNameInput.value = data.staff_name || '';
          departmentInput.value = data.department || '';
        } catch (err) {
          console.error('Error fetching staff info:', err);
          staffNameInput.value = '';
          departmentInput.value = '';
        }
      });
  
      // OPTIONAL: Prevent empty signature inputs from being submitted
      // This ensures req.body does not contain empty fields
      const form = document.querySelector('form');
      form.addEventListener('submit', () => {
        const staffSignInput = document.getElementById('emp_sign');
        const hodSignInput = document.getElementById('hr_clinic_sign');
        const sidFPArtyInput = document.getElementById('sid_fparty_sign');
        if (staffSignInput && staffSignInput.value.trim() === '') {
          staffSignInput.remove();
        }
        if (hodSignInput && hodSignInput.value.trim() === '') {
          hodSignInput.remove();
        }
        if (sidFPArtyInput && sidFPArtyInput.value.trim() === '') {
            sidFPArtyInput.remove();
        }
      });
    });
  </script>
  
  
