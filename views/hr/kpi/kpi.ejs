<script>
  document.addEventListener('DOMContentLoaded', () => {
    // === Signature Setup Function ===
    function setupSignature(canvasId, inputId, clearBtnId) {
      const canvas = document.getElementById(canvasId);
      const ctx = canvas.getContext('2d');
      const input = document.getElementById(inputId);
      const clearBtn = document.getElementById(clearBtnId);
      if (!canvas || !ctx || !input || !clearBtn) return () => {};

      let drawing = false, lastX = 0, lastY = 0;
      function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches && e.touches[0];
        const x = ((touch ? touch.clientX : e.clientX) - rect.left);
        const y = ((touch ? touch.clientY : e.clientY) - rect.top);
        return { x, y };
      }

      ['mousedown','touchstart'].forEach(evt => {
        canvas.addEventListener(evt, e => {
          e.preventDefault();
          drawing = true;
          const pos = getPos(e);
          lastX = pos.x;
          lastY = pos.y;
        });
      });

      ['mouseup','mouseout','touchend','touchcancel'].forEach(evt => {
        canvas.addEventListener(evt, () => {
          drawing = false;
        });
      });

      ['mousemove','touchmove'].forEach(evt => {
        canvas.addEventListener(evt, e => {
          if (!drawing) return;
          const pos = getPos(e);
          ctx.beginPath();
          ctx.moveTo(lastX, lastY);
          ctx.lineTo(pos.x, pos.y);
          ctx.stroke();
          lastX = pos.x;
          lastY = pos.y;
        });
      });

      clearBtn.addEventListener('click', () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        input.value = '';
      });

      return () => {
        input.value = canvas.toDataURL();
      };
    }

    // === Initialize Signature Pads ===
    ['staff_sign','hod_sign','hr_sign','director_sign','staff_sign1','hod_sign1'].forEach(id => {
      window['save_' + id] = setupSignature(
        id + '-pad',   // canvas element ID
        id,            // hidden input ID
        'clear-' + id  // clear button ID
      );
    });

    // === KPI Sum Logic (unchanged) ===
    function updateSum(blockClass, sumClass) {
      const inputs = document.querySelectorAll(`.${blockClass}`);
      const sum = Array.from(inputs).reduce((acc, i) => acc + (parseFloat(i.value) || 0), 0);
      document.querySelector(`.${sumClass}`).textContent = sum;
      document.getElementById(sumClass).value = sum;
      const total = ['block1-sum','block2-sum','block3-sum']
        .reduce((t, id) => t + (parseFloat(document.getElementById(id).value) || 0), 0);
      document.getElementById('block-total').value = total;
      document.getElementById('block-total-display').textContent = total;
    }
    ['block1-input','block2-input','block3-input'].forEach((cls,i) => {
      document.querySelectorAll(`.${cls}`).forEach(inp =>
        inp.addEventListener('input', () => updateSum(cls, `block${i+1}-sum`))
      );
    });
    // Initial calculation
    updateSum('block1-input','block1-sum');
    updateSum('block2-input','block2-sum');
    updateSum('block3-input','block3-sum');

    // === Auto-fill Staff Details ===
    document.getElementById('staff_id').addEventListener('change', async function() {
      const id = this.value;
      ['staff_name','current_phone','department'].forEach(f => {
        const el = document.getElementById(f);
        if (el) el.value = '';
      });
      if (!id) return;
      try {
        const res = await fetch('/staff/get-staff-details', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ staff_id: id })
        });
        const data = await res.json();
        if (data.staff) {
          document.getElementById('staff_name').value = data.staff.staff_name || '';
          document.getElementById('current_phone').value = data.staff.staff_phone || '';
          document.getElementById('department').value = data.staff.department || '';
        }
      } catch(err) {
        console.error('Error fetching staff details:', err);
      }
    });

    // === Form Submit: capture signatures ===
    const form = document.querySelector('form');
    form.addEventListener('submit', e => {
      ['staff_sign','hod_sign','hr_sign','director_sign','staff_sign1','hod_sign1'].forEach(id => {
        window['save_' + id]?.();
      });
      // allow normal submission (hidden inputs now hold dataURL strings)
    });
  });
</script>


