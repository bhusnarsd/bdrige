<script>
document.addEventListener('DOMContentLoaded', () => {
  // === Signature Configuration ===
  const signatureConfig = [
    { canvasId: 'staff_sign-pad', inputId: 'staff_sign' },
    { canvasId: 'hod_sign-pad', inputId: 'hod_sign' },
    { canvasId: 'hr_sign-pad', inputId: 'hr_sign' },
    { canvasId: 'director_sign-pad', inputId: 'director_sign' },
    { canvasId: 'staff_sign1-pad', inputId: 'staff_sign1' },
    { canvasId: 'hod_sign1-pad', inputId: 'hod_sign1' }
  ];

  // === Signature Pad Setup ===
  function setupSignaturePad(canvasId, inputId) {
    const canvas = document.getElementById(canvasId);
    const input = document.getElementById(inputId);
    
    if (!canvas || !input) {
      console.error(`Missing elements for ${canvasId} or ${inputId}`);
      return null;
    }

    // Set canvas size explicitly to prevent scaling issues
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width;
    canvas.height = rect.height;
    
    const ctx = canvas.getContext('2d');
    ctx.lineWidth = 2;
    ctx.strokeStyle = '#000000';
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    
    let drawing = false;
    let lastX = 0;
    let lastY = 0;
    let hasDrawn = false; // Track if anything has been drawn

    function getPosition(event) {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const touch = event.touches?.[0] || event;
      return {
        x: (touch.clientX - rect.left) * scaleX,
        y: (touch.clientY - rect.top) * scaleY
      };
    }

    function startDrawing(event) {
      event.preventDefault();
      drawing = true;
      const pos = getPosition(event);
      lastX = pos.x;
      lastY = pos.y;
      
      // Start a new path
      ctx.beginPath();
      ctx.moveTo(lastX, lastY);
    }

    function stopDrawing(event) {
      if (!drawing) return;
      event.preventDefault();
      drawing = false;
      hasDrawn = true;
      
      // Immediately save signature when drawing stops
      setTimeout(() => saveSignature(), 10);
    }

    function draw(event) {
      if (!drawing) return;
      event.preventDefault();
      
      const pos = getPosition(event);
      ctx.lineTo(pos.x, pos.y);
      ctx.stroke();
      lastX = pos.x;
      lastY = pos.y;
    }

    function saveSignature() {
      try {
        if (!hasDrawn) {
          input.value = '';
          return false;
        }
        
        const signatureData = canvas.toDataURL('image/png');
        
        // Check if canvas is truly empty by comparing with blank canvas
        const blankCanvas = document.createElement('canvas');
        blankCanvas.width = canvas.width;
        blankCanvas.height = canvas.height;
        const blankData = blankCanvas.toDataURL('image/png');
        
        if (signatureData !== blankData && signatureData.length > 1000) {
          input.value = signatureData;
          console.log(`Signature saved for ${inputId}:`, signatureData.substring(0, 50) + '...');
          return true;
        } else {
          input.value = '';
          return false;
        }
      } catch (error) {
        console.error(`Error saving signature for ${inputId}:`, error);
        input.value = '';
        return false;
      }
    }

    function clearSignature() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      input.value = '';
      hasDrawn = false;
      console.log(`Signature cleared for ${inputId}`);
    }

    // Mouse Events
    canvas.addEventListener('mousedown', startDrawing);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDrawing);
    canvas.addEventListener('mouseout', stopDrawing);

    // Touch Events
    canvas.addEventListener('touchstart', startDrawing, { passive: false });
    canvas.addEventListener('touchmove', draw, { passive: false });
    canvas.addEventListener('touchend', stopDrawing, { passive: false });
    canvas.addEventListener('touchcancel', stopDrawing, { passive: false });

    // Clear button setup
    const clearBtn = document.getElementById(`clear-${inputId}`);
    if (clearBtn) {
      clearBtn.addEventListener('click', (e) => {
        e.preventDefault();
        clearSignature();
      });
    }

    return {
      save: saveSignature,
      clear: clearSignature,
      isEmpty: () => !input.value || input.value.trim() === '',
      hasContent: () => hasDrawn && input.value && input.value.length > 1000
    };
  }

  // Initialize all signature pads
  const signaturePads = signatureConfig.map(config => ({
    ...config,
    pad: setupSignaturePad(config.canvasId, config.inputId)
  })).filter(item => item.pad !== null);

  // === Form Submission Handler ===
  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault(); // Always prevent default first

      console.log('Form submission started...');

      // Force save all signatures before validation
      const signatureResults = [];
      signaturePads.forEach(({ inputId, pad }) => {
        if (pad) {
          const saved = pad.save();
          const hasContent = pad.hasContent();
          signatureResults.push({
            inputId,
            saved,
            hasContent,
            value: document.getElementById(inputId)?.value || ''
          });
          console.log(`${inputId}: saved=${saved}, hasContent=${hasContent}, valueLength=${document.getElementById(inputId)?.value?.length || 0}`);
        }
      });

      // Check for missing required signatures
      const missingSignatures = signatureResults.filter(result => !result.hasContent);
      
      if (missingSignatures.length > 0) {
        const missingNames = missingSignatures.map(s => s.inputId).join(', ');
        alert(`Please provide all required signatures. Missing: ${missingNames}`);
        return false;
      }

      // Final validation - check all hidden inputs have data
      let allSignaturesValid = true;
      signaturePads.forEach(({ inputId }) => {
        const input = document.getElementById(inputId);
        if (!input || !input.value || input.value.length < 1000) {
          console.error(`Invalid signature data for ${inputId}`);
          allSignaturesValid = false;
        }
      });

      if (!allSignaturesValid) {
        alert('Error processing signatures. Please redraw any missing signatures and try again.');
        return false;
      }

      console.log('All signatures validated successfully. Submitting form...');
      
      // Add a small delay to ensure all data is processed
      setTimeout(() => {
        form.submit();
      }, 100);
    });
  }

  // === KPI Sum Logic ===
  function updateSum(blockClass, sumClass) {
    const inputs = document.querySelectorAll(`.${blockClass}`);
    const sum = Array.from(inputs).reduce((acc, i) => acc + (parseFloat(i.value) || 0), 0);
    
    const sumDisplay = document.querySelector(`.${sumClass}`);
    if (sumDisplay) sumDisplay.textContent = sum;
    
    const sumInput = document.getElementById(sumClass);
    if (sumInput) sumInput.value = sum;

    // Update total
    const total = ['block1-sum','block2-sum','block3-sum']
      .reduce((t, id) => t + (parseFloat(document.getElementById(id)?.value) || 0), 0);
    
    const totalInput = document.getElementById('block-total');
    const totalDisplay = document.getElementById('block-total-display');
    
    if (totalInput) totalInput.value = total;
    if (totalDisplay) totalDisplay.textContent = total;
  }

  // Initialize KPI sum calculations
  ['block1-input','block2-input','block3-input'].forEach((cls, i) => {
    document.querySelectorAll(`.${cls}`).forEach(inp =>
      inp.addEventListener('input', () => updateSum(cls, `block${i+1}-sum`))
    );
    updateSum(cls, `block${i+1}-sum`); // Initial calculation
  });

  // === Staff Details Autofill ===
  const staffIdSelect = document.getElementById('staff_id');
  if (staffIdSelect) {
    staffIdSelect.addEventListener('change', async function() {
      const id = this.value;
      if (!id) {
        ['staff_name','current_phone','department'].forEach(f => {
          const el = document.getElementById(f);
          if (el) el.value = '';
        });
        return;
      }

      try {
        const res = await fetch('/staff/get-staff-details', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ staff_id: id })
        });
        
        const data = await res.json();
        if (data.staff) {
          document.getElementById('staff_name').value = data.staff.staff_name || '';
          document.getElementById('current_phone').value = data.staff.staff_phone || '';
          document.getElementById('department').value = data.staff.department || '';
        }
      } catch(err) {
        console.error('Error fetching staff details:', err);
      }
    });
  }
});
</script>
