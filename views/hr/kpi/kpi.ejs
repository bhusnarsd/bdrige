<%- include('../../partials/header') %>
<div class="container">
  <%- include('../../partials/left-panel') %>
  <div class="right-panel">
    <div class="content-area">
      <% if (messages.error) { %>
      <div style="color: red; margin-bottom: 20px;">
        <%= messages.error %>
      </div>
      <% } %>
      <% if (messages.success) { %>
      <div style="color: green; margin-bottom: 20px;"><%= messages.success %></div>
      <% } %>

      <div class="breadcrumbs">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/hr/kpi">KPI</a></li>
          <li>Key Performance Indicator</li>
        </ul>
      </div>
      <div class="form-area">
        <h2>Key Performance Indicator</h2>
        <div class="form-box">
          <form action="/hr/kpi/create" method="POST" enctype="multipart/form-data">
            <div class="form-row">
              <div class="form-group">
                <label for="staff_id">Unique id:</label>
                <select id="staff_id" name="staff_id" required>
                  <option value="">-- Select Unique ID --</option>
                  <% if (staffList && staffList.length) { %>
                    <% staffList.forEach(staff => { %>
                      <option value="<%= staff.staff_id %>"><%= staff.staff_id %></option>
                    <% }) %>
                  <% } else { %>
                    <option value="">No staff found</option>
                  <% } %>
                </select>
                <!-- <input type="text" id="staff_id_search" name="staff_id_search" placeholder="Staff Id" required>
                <input type="hidden" id="staff_id" name="staff_id"> -->
              </div>
              <div class="form-group">
                <label for="staff_name">Employee Name:</label>
                <input type="text" id="staff_name" name="staff_name" placeholder="staff_name" readonly>
              </div>
              <div class="form-group">
                <label for="current_phone">Current Phone (In Dubai)</label>
                <input type="tel" id="current_phone" name="current_phone" placeholder="Current Phone (In Dubai)">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="kpi_date">Date:</label>
                <input type="date" id="kpi_date" name="kpi_date">
              </div>
              <div class="form-group">
                <label for="dept">Department</label>
                <select id="dept" name="department" required>
                  <option value="">-- Select Department --</option>
                  <option value="Clinic Manager">Clinic Manager</option>
                  <option value="Speech Therapist">Speech Therapist</option>
                  <option value="OT">OT</option>
                  <option value="Physiotherapist">Physiotherapist</option>
                  <option value="ABA">ABA</option>
                  <option value="ABA Supervisor">ABA Supervisor</option>
                  <option value="Psychologist">Psychologist</option>
                  <option value="Intern-Speech Therapist">Intern-Speech Therapist</option>
                  <option value="Light Vehicle Driver">Light Vehicle Driver</option>
                  <option value="Cleaner">Cleaner</option>
                  <option value="Admin">Admin</option>
                  <option value="Driver">Driver</option>
                  <option value="Marketing Executive">Marketing Executive</option>
                  <option value="Marketing Manager">Marketing Manager</option>
                </select>
              </div>
              <div class="form-group">
                <label for="email">Evaluation period</label>
                <label><input type="radio" name="e_period" value="1st Q: Jan-May" required> 1st Q: Jan-May</label>
                <label><input type="radio" name="e_period" value="2nd Q: June-Sept" required> 2nd Q: June-Sept</label>
                <label><input type="radio" name="e_period" value="3rd Q: Oct-Dec" required> 3rd Q: Oct-Dec</label>
              </div>
            </div>
            <h4>Key Performance Indicator</h4>
            <div class="tablewrapper">
              <div class="table-responsive">
                <table class="table table-condensed table-striped-height">
                  <thead class="tablehead">
                    <tr>
                      <th class="" colspan="2">Quarter: </th>
                    </tr>
                  </thead>
                  <tbody class="tablebody">
                    <tr>
                      <td>1.</td>
                      <td><input type="text" id="kpi_text1" name="kpi_text1" value="ddd" required></td>
                    </tr>
                    <tr>
                      <td>2.</td>
                      <td><input type="text" id="kpi_text2" name="kpi_text2" value="bbbb" required></td>
                    </tr>
                    <tr>
                      <td>3.</td>
                      <td><input type="text" id="kpi_text3" name="kpi_text3" value="nnnn" required></td>
                    </tr>
                    <tr>
                      <td>4.</td>
                      <td><input type="text" id="kpi_text4" name="kpi_text4" value="mmmmm" required></td>
                    </tr>
                    <tr>
                      <td>5.</td>
                      <td><input type="text" id="kpi_text5" name="kpi_text5" value="sssss" required></td>
                    </tr>
                    <tr>
                      <td>
                        <label for="staff_sign">Employee’s Signature</label>
                        <canvas id="staff_sign-pad" width="300" height="150" style="border:1px solid #ccc;"></canvas>
                        <button type="button" id="clear-staff_sign">Clear</button>
                        <input type="hidden" id="staff_sign" name="staff_sign">
                      </td>
