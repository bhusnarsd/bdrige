<script>
  // Function to initialize the canvas drawing behavior
  function initializeSignatureCanvas(canvasId, inputId) {
    const canvas = document.getElementById(canvasId);
    const ctx = canvas.getContext('2d');
    let drawing = false;
    let lastX = 0;
    let lastY = 0;

    // Function to get the position of the pointer (mouse or touch)
    function getPosition(event) {
      const rect = canvas.getBoundingClientRect();
      const x = event.touches ? event.touches[0].clientX - rect.left : event.clientX - rect.left;
      const y = event.touches ? event.touches[0].clientY - rect.top : event.clientY - rect.top;
      return {
        x,
        y
      };
    }

    // Start drawing when mouse is pressed or touch starts
    canvas.addEventListener('mousedown', (event) => {
      drawing = true;

      // Get the mouse position relative to the canvas
      // const rect = canvas.getBoundingClientRect();
      // lastX = event.clientX - rect.left;
      // lastY = event.clientY - rect.top;
      const {
        x,
        y
      } = getPosition(event);
      lastX = x;
      lastY = y;
    });
    // Start drawing on touch start (mobile/tablets)
    canvas.addEventListener('touchstart', (event) => {
      event.preventDefault(); // Prevents the default touch action (scrolling)
      drawing = true;
      const {
        x,
        y
      } = getPosition(event);
      lastX = x;
      lastY = y;
    });

    // Stop drawing when mouse is released or touch ends
    canvas.addEventListener('mouseup', () => {
      drawing = false;
    });
    // Stop drawing on touch end
    canvas.addEventListener('touchend', () => {
      drawing = false;
    });

    // Draw on canvas when mouse is moved or touch moves and drawing is true
    canvas.addEventListener('mousemove', (event) => {
      if (drawing) {
        // const rect = canvas.getBoundingClientRect();
        // const x = event.clientX - rect.left;
        // const y = event.clientY - rect.top;
        const {
          x,
          y
        } = getPosition(event);

        // Draw a line from the last position to the current position
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(x, y);
        ctx.stroke();

        lastX = x; // Update lastX to the current position
        lastY = y; // Update lastY to the current position
      }
    });
    // Draw on canvas when touch moves
    canvas.addEventListener('touchmove', (event) => {
      if (drawing) {
        const {
          x,
          y
        } = getPosition(event);
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(x, y);
        ctx.stroke();

        lastX = x;
        lastY = y;
      }
    });
  }

  // Function to handle form submission
  function handleFormSubmit(event) {
    // Get the canvas data for each signature field
    const staffSignData = document.getElementById('staff_sign').toDataURL();
    const hodSignData = document.getElementById('hod_sign').toDataURL();
    const hrSignData = document.getElementById('hr_sign').toDataURL();
    const directorSignData = document.getElementById('director_sign').toDataURL();
    const staffSign1Data = document.getElementById('staff_sign1').toDataURL();
    const hodSign1Data = document.getElementById('hod_sign1').toDataURL();

    // Set the hidden input fields with the canvas data
    document.getElementById('staff_sign_input').value = staffSignData;
    document.getElementById('hod_sign_input').value = hodSignData;
    document.getElementById('hr_sign_input').value = hrSignData;
    document.getElementById('director_sign_input').value = directorSignData;
    document.getElementById('staff_sign1_input').value = staffSign1Data;
    document.getElementById('hod_sign1_input').value = hodSign1Data;

    // console.log('Form data:', {
    //   staffSignData,
    //   hodSignData,
    //   hrSignData,
    //   directorSignData,
    //   staffSign1Data,
    //   hodSign1Data
    // });

    // Proceed with the form submission after populating the signature data
    // If you're submitting with AJAX, prevent the default behavior
    // event.preventDefault(); // Only needed for AJAX submission
    document.querySelector('form').submit(); // Submit the form after setting the hidden inputs
  }

  // Initialize all signature canvases
  window.onload = function() {
    // Initialize signature canvases
    initializeSignatureCanvas('staff_sign', 'staff_sign_input');
    initializeSignatureCanvas('hod_sign', 'hod_sign_input');
    initializeSignatureCanvas('hr_sign', 'hr_sign_input');
    initializeSignatureCanvas('director_sign', 'director_sign_input');
    initializeSignatureCanvas('staff_sign1', 'staff_sign1_input');
    initializeSignatureCanvas('hod_sign1', 'hod_sign1_input');

    // Add submit event listener to the form
    document.querySelector('form').addEventListener('submit', (event) => {
      event.preventDefault(); // Prevent form submission for manual handling

      handleFormSubmit(event); // Handle form submission after populating signature fields

      // Optionally, submit the form via AJAX if you're not doing a regular form post
      // form.submit(); // Or manually trigger the form submission after handling signatures
    });
  };




