  document.addEventListener('DOMContentLoaded', function() {
  // Function to calculate and update the sum for a specific block
  function updateSum(blockClass, sumClass) {
    const inputs = document.querySelectorAll(`.${blockClass}`);
    const totalDisplay = document.querySelector(`.${sumClass}`);
    const totalDisplayInTxt = document.querySelector(`#${sumClass}`);
    const allTotalDisplayInTxt = document.querySelector('#block-total');
    const totalDisplayElement = document.querySelector('#block-total-display');

    if (!totalDisplay || !totalDisplayInTxt || !allTotalDisplayInTxt || !totalDisplayElement) {
        console.error('One or more elements are missing!');
        return;  // Prevent errors if elements don't exist
    }

    let total = 0;

    // Loop through the inputs in the block and calculate the total sum
    inputs.forEach(input => {
      total += parseFloat(input.value) || 0;  // Handle invalid inputs by using 0 as fallback
    });

    // Update the sum in the designated span
    totalDisplay.textContent = total;
    totalDisplayInTxt.value = total;
    
    // Log the individual block total
    console.log(`Total for block: ${total}`);

    // Update the total of all `totalDisplayInTxt` values (block1-sum, block2-sum, block3-sum)
    const allTotal = [
        document.querySelector('#block1-sum'),
        document.querySelector('#block2-sum'),
        document.querySelector('#block3-sum')
    ].reduce((acc, sumElement) => acc + (parseFloat(sumElement.value) || 0), 0);

    // Log the sum of all blocks
    console.log(`All total: ${allTotal}`);

    // Update the overall total in #block-total
    // Force a reflow by resetting and updating the value
    allTotalDisplayInTxt.value = '';  // Reset first
    allTotalDisplayInTxt.value = allTotal;  // Update with the total

    // Update the displayed total
    totalDisplayElement.textContent = allTotal;  // Update span with total
    console.log(`Updated block-total: ${allTotalDisplayInTxt.value}`);
  }

  // Add event listeners to input fields in each block to update the sum dynamically
  document.querySelectorAll('.block1-input').forEach(input => {
    input.addEventListener('input', () => updateSum('block1-input', 'block1-sum'));
  });
  
  document.querySelectorAll('.block2-input').forEach(input => {
    input.addEventListener('input', () => updateSum('block2-input', 'block2-sum'));
  });

  document.querySelectorAll('.block3-input').forEach(input => {
    input.addEventListener('input', () => updateSum('block3-input', 'block3-sum'));
  });

  // Call the updateSum function once on page load for each block
  updateSum('block1-input', 'block1-sum');
  updateSum('block2-input', 'block2-sum');
  updateSum('block3-input', 'block3-sum');
});

