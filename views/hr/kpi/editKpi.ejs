                <label><input type="radio" name="e_period" value="1st Q: Jan-May" <%= kpi.e_period === '1st Q: Jan-May' ? 'checked' : '' %> required> 1st Q: Jan-May</label>
                <label><input type="radio" name="e_period" value="2nd Q: June-Sept" <%= kpi.e_period === '2nd Q: June-Sept' ? 'checked' : '' %> required> 2nd Q: June-Sept</label>
                <label><input type="radio" name="e_period" value="3rd Q: Oct-Dec" <%= kpi.e_period === '3rd Q: Oct-Dec' ? 'checked' : '' %> required> 3rd Q: Oct-Dec</label>
