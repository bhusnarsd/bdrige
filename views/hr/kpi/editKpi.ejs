<script>
  document.addEventListener('DOMContentLoaded', function () {
    const signatureFields = [
      { imageId: 'hr_sign_preview', inputId: 'hr_sign' },
      { imageId: 'director_sign_preview', inputId: 'director_sign' },
      { imageId: 'staff_sign1_preview', inputId: 'staff_sign1' },
      { imageId: 'hod_sign1_preview', inputId: 'hod_sign1' },
      { imageId: 'staff_signature_preview', inputId: 'staff_sign_input' },
      { imageId: 'hod_sign_preview', inputId: 'hod_sign_input' }
    ];

    signatureFields.forEach(({ imageId, inputId }) => {
      const img = document.getElementById(imageId);
      const input = document.getElementById(inputId);

      if (img && img.src) {
        // If the image is valid, disable the corresponding input (hidden or otherwise)
        img.onload = function () {
          if (img.naturalWidth && img.naturalHeight && input) {
            input.disabled = true;
          }
        };

        if (img.complete) {
          if (img.naturalWidth && img.naturalHeight && input) {
            input.disabled = true;
          }
        }
      }

      // Always hide canvas if exists (edit form shouldn't allow drawing)
      const canvasId = imageId.replace('_preview', '-pad');
      const canvas = document.getElementById(canvasId);
      if (canvas) {
        canvas.style.display = 'none';
      }
    });

    // === SUM CALCULATIONS ===
    function updateSum(blockClass, sumClass) {
      const inputs = document.querySelectorAll(`.${blockClass}`);
      const totalDisplay = document.querySelector(`.${sumClass}`);
      const totalDisplayInTxt = document.querySelector(`#${sumClass}`);
      const allTotalDisplayInTxt = document.querySelector('#block-total');
      const totalDisplayElement = document.querySelector('#block-total-display');

      if (!totalDisplay || !totalDisplayInTxt || !allTotalDisplayInTxt || !totalDisplayElement) {
        console.error('One or more elements are missing!');
        return;
      }

      let total = 0;
      inputs.forEach(input => {
        total += parseFloat(input.value) || 0;
      });

      totalDisplay.textContent = total;
      totalDisplayInTxt.value = total;

      const allTotal = [
        document.querySelector('#block1-sum'),
        document.querySelector('#block2-sum'),
        document.querySelector('#block3-sum')
      ].reduce((acc, el) => acc + (parseFloat(el?.value) || 0), 0);

      allTotalDisplayInTxt.value = '';
      allTotalDisplayInTxt.value = allTotal;
      totalDisplayElement.textContent = allTotal;
    }

    ['block1-input', 'block2-input', 'block3-input'].forEach((block, i) => {
      document.querySelectorAll(`.${block}`).forEach(input => {
        input.addEventListener('input', () => updateSum(block, `block${i + 1}-sum`));
      });
      updateSum(block, `block${i + 1}-sum`);
    });
  });
</script>

  
