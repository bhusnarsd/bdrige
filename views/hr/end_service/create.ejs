<%- include('../../partials/header') %>
  <div class="container">
    <%- include('../../partials/left-panel') %>
      <div class="right-panel">
        <div class="content-area">
          <% if (messages.error) { %>
            <div style="color: red; margin-bottom: 20px;">
              <%= messages.error %>
            </div>
            <% } %>
              <% if (messages.success) { %>
                <div style="color: green; margin-bottom: 20px;">
                  <%= messages.success %>
                </div>
                <% } %>

                  <div class="breadcrumbs">
                    <ul>
                      <li><a href="/">Home</a></li>
                      <li><a href="/hr/es">End Service List</a></li>
                      <li>End Service</li>
                    </ul>
                  </div>
                  <div class="form-area">
                    <h2>Staff End Service</h2>
                    <div class="form-box">
                      <div id="formErrors" class="error-messages" style="color: red; display: none; margin-bottom: 15px;"></div>

                      <form action="/hr/es/create" method="POST">
                        <div class="form-row">
                          <div class="form-row">
                            <div class="form-group">
                              <label for="staff_id">Unique ID</label>
                              <select id="staff_id" name="staff_id" required>
                                <option value="">-- Select Unique ID --</option>
                                <% if (staffList && staffList.length) { %>
                                  <% staffList.forEach(staff=> { %>
                                    <option value="<%= staff.staff_id %>">
                                      <%= staff.staff_id %>
                                    </option>
                                    <% }); %>
                                      <% } else { %>
                                        <option value="">No staff found</option>
                                        <% } %>
                              </select>

                            </div>
                            <div class="form-group">
                              <label for="staff_name">Employee Name</label>
                              <input type="text" id="staff_name" name="staff_name" placeholder="Staff Name" readonly>
                            </div>
                          </div>
                          <div class="form-row">
                            <div class="form-group">
                              <label for="dept">Department</label>
                              <select id="dept" name="dept" required>
                                <option value="">-- Select Department --</option>
                                <option value="Clinic Manager">Clinic Manager</option>
                                <option value="Speech Therapist">Speech Therapist</option>
                                <option value="OT">OT</option>
                                <option value="Physiotherapist">Physiotherapist</option>
                                <option value="ABA">ABA</option>
                                <option value="ABA Supervisor">ABA Supervisor</option>
                                <option value="Psychologist">Psychologist</option>
                                <option value="Intern-Speech Therapist">Intern-Speech Therapist</option>
                                <option value="Light Vehicle Driver">Light Vehicle Driver</option>
                                <option value="Cleaner">Cleaner</option>
                                <option value="Admin">Admin</option>
                                <option value="Driver">Driver</option>
                                <option value="Marketing Executive">Marketing Executive</option>
                                <option value="Marketing Manager">Marketing Manager</option>
                              </select>
                            </div>
                            
                            <!-- <div class="form-group">
                              <label for="email">Department</label>
                              <input type="text" id="dept" name="dept" required>
                            </div> -->
                            <div class="form-group">
                              <label for="phone">Job Title</label>
                              <input type="text" id="job_title" name="job_title" required>
                            </div>
                          </div>
                          <div class="content">
                            <div class="tablewrapper">
                              <div class="table-responsive">
                                <table class="table table-condensed table-striped">
                                  <thead class="tablehead">
                                    <tr>
                                      <th>Procedure</th>
                                      <th>Date</th>
                                      <th>Complete/ Incomplete</th>
                                    </tr>
                                  </thead>
                                  <tbody class="tablebody">
                                    <tr>
                                      <td>Notice of Resignation Submit a formal resignation letter to your medical
                                        Director /Clinic Manager/HOD via email and hard copy.</td>
                                      <td><input type="date" id="procd_norsafrl_date" name="procd_norsafrl_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_norsafrl_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_norsafrl_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Acknowledgment of Resignation HR acknowledges receipt of the resignation
                                        letter and provides further instructions.</td>
                                      <td><input type="date" id="procd_aorharot_date" name="procd_aorharot_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_aorharot_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_aorharot_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Exit Interview Schedule and conduct an exit interview with HR to discuss
                                        reasons for leaving and provide feedback.</td>
                                      <td><input type="date" id="procd_eisacaeiwh_date" name="procd_eisacaeiwh_date">
                                      </td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_eisacaeiwh_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_eisacaeiwh_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Handover of Duties Complete a detailed handover of duties to the
                                        supervisor/HOD/successor.</td>
                                      <td><input type="date" id="procd_hodcadh_date" name="procd_hodcadh_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_hodcadh_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_hodcadh_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Return of Company Property </td>
                                      <td><input type="date" id="procd_rocp_date" name="procd_rocp_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_rocp_status" value="Complete" required>
                                            Complete</label>
                                          <label><input type="radio" name="procd_rocp_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>ID’s </td>
                                      <td><input type="date" id="procd_ids_date" name="procd_ids_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_ids_status" value="Complete" required>
                                            Complete</label>
                                          <label><input type="radio" name="procd_ids_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Flash Cards</td>
                                      <td><input type="date" id="procd_fc_date" name="procd_fc_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_fc_status" value="Complete" required>
                                            Complete</label>
                                          <label><input type="radio" name="procd_fc_status" value="InComplete" required>
                                            InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Keys</td>
                                      <td><input type="date" id="procd_keys_date" name="procd_keys_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_keys_status" value="Complete" required>
                                            Complete</label>
                                          <label><input type="radio" name="procd_keys_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Therapy Resources</td>
                                      <td><input type="date" id="procd_tr_date" name="procd_tr_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_tr_status" value="Complete" required>
                                            Complete</label>
                                          <label><input type="radio" name="procd_tr_status" value="InComplete" required>
                                            InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Settlement of Accounts: Total Amount</td>
                                      <td><input type="date" id="procd_soata_date" name="procd_soata_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_soata_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_soata_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Outstanding payments</td>
                                      <td><input type="date" id="procd_op_date" name="procd_op_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_op_status" value="Complete" required>
                                            Complete</label>
                                          <label><input type="radio" name="procd_op_status" value="InComplete" required>
                                            InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Salary</td>
                                      <td><input type="date" id="procd_sal_date" name="procd_sal_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_sal_status" value="Complete" required>
                                            Complete</label>
                                          <label><input type="radio" name="procd_sal_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Gratuity</td>
                                      <td><input type="date" id="procd_gt_date" name="procd_gt_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_gt_status" value="Complete" required>
                                            Complete</label>
                                          <label><input type="radio" name="procd_gt_status" value="InComplete" required>
                                            InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Unused leaves</td>
                                      <td><input type="date" id="procd_ul_date" name="procd_ul_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_ul_status" value="Complete" required>
                                            Complete</label>
                                          <label><input type="radio" name="procd_ul_status" value="InComplete" required>
                                            InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Clearance Form Obtain and complete a clearance form, getting necessary
                                        signatures from relevant departments.</td>
                                      <td><input type="date" id="procd_cfoacacf_date" name="procd_cfoacacf_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_cfoacacf_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_cfoacacf_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>End of Service Benefits Calculation HR calculates end-of-service benefits
                                        based on company policy and labor laws.</td>
                                      <td><input type="date" id="procd_eosbchce_date" name="procd_eosbchce_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_eosbchce_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_eosbchce_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Cancellation of labor card Cancel the labor card, License under Bridges, and
                                        insurance.</td>
                                      <td><input type="date" id="procd_colcctlc_date" name="procd_colcctlc_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_colcctlc_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_colcctlc_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Final Settlement Payment Receive final settlement payment, including
                                        end-of-service benefits and any remaining dues.</td>
                                      <td><input type="date" id="procd_fsprfsp_date" name="procd_fsprfsp_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_fsprfsp_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_fsprfsp_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Release Certificate HR issues an experience letter.</td>
                                      <td><input type="date" id="procd_rchiael_date" name="procd_rchiael_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_rchiael_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_rchiael_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td>Feedback and Follow-up Provide feedback on the resignation process and follow
                                        up on any pending issues if needed.</td>
                                      <td><input type="date" id="procd_fafupfot_date" name="procd_fafupfot_date"></td>
                                      <td>
                                        <div class="radio-group">
                                          <label><input type="radio" name="procd_fafupfot_status" value="Complete"
                                              required> Complete</label>
                                          <label><input type="radio" name="procd_fafupfot_status" value="InComplete"
                                              required> InComplete</label>
                                        </div>
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </div>
                            </div>
                            <h4>RECITALS</h4>
                            <div class="tablewrapper">
                              <div class="table-responsive">
                                <table class="table table-condensed table-striped">
                                  <tbody class="tablebody">
                                    <tr>
                                      <td>What is your primary reason for leaving the company?</td>
                                      <td><input type="text" id="recit_wiyprfltc" name="recit_wiyprfltc"></td>
                                    </tr>
                                    <tr>
                                      <td>How satisfied were you with your job responsibilities?</td>
                                      <td><input type="text" id="recit_hswywyjr" name="recit_hswywyjr"></td>
                                    </tr>
                                    <tr>
                                      <td>What did you enjoy most about your job?</td>
                                      <td><input type="text" id="recit_wdyemayj" name="recit_wdyemayj"></td>
                                    </tr>
                                    <tr>
                                      <td>What did you enjoy least about your job?</td>
                                      <td><input type="text" id="recit_wdyelayj" name="recit_wdyelayj"></td>
                                    </tr>
                                    <tr>
                                      <td>Were your skills and abilities utilized to their fullest potential?</td>
                                      <td><input type="text" id="recit_wysaauttfp" name="recit_wysaauttfp"></td>
                                    </tr>
                                    <tr>
                                      <td>Did you receive adequate support and resources to do your job effectively?
                                      </td>
                                      <td><input type="text" id="recit_dyrasartdyje" name="recit_dyrasartdyje"></td>
                                    </tr>
                                    <tr>
                                      <td>How would you describe the work environment and culture at the company?</td>
                                      <td><input type="text" id="recit_hwydtweacatc" name="recit_hwydtweacatc"></td>
                                    </tr>
                                    <tr>
                                      <td>Did you feel valued and appreciated as an employee?</td>
                                      <td><input type="text" id="recit_dyfvaaaae" name="recit_dyfvaaaae"></td>
                                    </tr>
                                    <tr>
                                      <td>Were there opportunities for professional growth and development?</td>
                                      <td><input type="text" id="recit_wtofpgad" name="recit_wtofpgad"></td>
                                    </tr>
                                    <tr>
                                      <td>How effective was the communication within your department and across the
                                        company?</td>
                                      <td><input type="text" id="recit_hewtcwydaatc" name="recit_hewtcwydaatc"></td>
                                    </tr>
                                    <tr>
                                      <td>Were you satisfied with the level of recognition and feedback you received?
                                      </td>
                                      <td><input type="text" id="recit_wyswtlorafyr" name="recit_wyswtlorafyr"></td>
                                    </tr>
                                    <tr>
                                      <td>How would you describe the work environment and culture at the company?</td>
                                      <td><input type="text" id="recit_hwydtweacatce" name="recit_hwydtweacatce"></td>
                                    </tr>
                                    <tr>
                                      <td>Would you consider rejoining the company in the future? Why or why not?</td>
                                      <td><input type="text" id="recit_wycrtcitfwown" name="recit_wycrtcitfwown"></td>
                                    </tr>
                                    <tr>
                                      <td>Do you have any suggestions for improving the workplace?</td>
                                      <td><input type="text" id="recit_dyhasfitw" name="recit_dyhasfitw"></td>
                                    </tr>
                                    <tr>
                                      <td>Is there anything else you would like to share about your experience with the
                                        company?</td>
                                      <td><input type="text" id="recit_itaeywltsayewtc" name="recit_itaeywltsayewtc">
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </div>
                            </div>

                            <div class="form-group">
                              <button type="submit">Submit</button>
                              <button type="reset">Reset</button>
                              <p id="errorMessage" style="color: red; display: none;">Please enter a valid 8-character
                                staff ID.</p>
                            </div>
                          </div>
                      </form>
                    </div>
                  </div>
        </div>
      </div>
  </div>

