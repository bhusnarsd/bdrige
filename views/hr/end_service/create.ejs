     <script>
      document.addEventListener('DOMContentLoaded', () => {
        const form = document.querySelector('form[action="/hr/es/create"]');
        const formErrorsDiv = document.getElementById('formErrors');
        const rows = form.querySelectorAll('.tablebody tr');
        const staffIdSelect = document.getElementById('staff_id');
        const staffNameInput = document.getElementById('staff_name');
        const submitButton = document.querySelector('button[type="submit"]');
        const errorMessage = document.getElementById('errorMessage');
      
        if (!form) {
          console.error("Target form not found!");
          return;
        }
      
        // Disable submit initially
        submitButton.disabled = true;
        submitButton.style.backgroundColor = 'gray';
      
        // ✅ Enforce only future dates
rows.forEach((row) => {
  const dateInput = row.querySelector('input[type="date"]');

  if (dateInput) {
    // Get tomorrow's date in yyyy-mm-dd
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const yyyy = tomorrow.getFullYear();
    const mm = String(tomorrow.getMonth() + 1).padStart(2, '0');
    const dd = String(tomorrow.getDate()).padStart(2, '0');
    const minDate = `${yyyy}-${mm}-${dd}`;

    dateInput.setAttribute('min', minDate);

    // Optional: if user manually types a past date, block it
    dateInput.addEventListener('input', () => {
      if (dateInput.value && dateInput.value < minDate) {
        alert('Please select a future date only.');
        dateInput.value = '';
      }
    });
  }
});

        // Set default: Incomplete checked + date disabled
        rows.forEach(row => {
          const radios = row.querySelectorAll('input[type="radio"]');
          const dateInput = row.querySelector('input[type="date"]');
      
          // Only apply radio/date defaults if radios exist
          if (radios.length > 0) {
            const inCompleteRadio = Array.from(radios).find(r => r.value === 'InComplete');
            if (inCompleteRadio) {
              inCompleteRadio.checked = true;
            }
            if (dateInput) {
              dateInput.disabled = true;
              dateInput.value = '';
            }
      
            radios.forEach(radio => {
              radio.addEventListener('change', () => {
                if (radio.value === 'InComplete' && radio.checked) {
                  if (dateInput) {
                    dateInput.value = '';
                    dateInput.disabled = true;
                    dateInput.style.border = '';
                  }
                } else if (radio.value === 'Complete' && radio.checked) {
                  if (dateInput) {
                    dateInput.disabled = false;
                  }
                }
                // Remove red border if any on change
                radio.parentElement.style.border = '';
              });
            });
      
            if (dateInput) {
              dateInput.addEventListener('input', () => {
                if (dateInput.value) {
                  dateInput.style.border = '';
                }
              });
            }
          }
        });
      
        // ✅ Form validation
        form.addEventListener('submit', function (e) {
          let allValid = true;
      
          rows.forEach((row) => {
            const radios = row.querySelectorAll('input[type="radio"]');
            const dateInput = row.querySelector('input[type="date"]');
      
            if (radios.length === 0) return; // Skip non-radio rows like recitals
      
            const radioName = radios[0].name;
            const selected = row.querySelector(`input[name="${radioName}"]:checked`);
      
            // Reset any old borders
            radios.forEach(radio => {
              radio.parentElement.style.border = '';
            });
            if (dateInput) {
              dateInput.style.border = '';
            }
      
            // Check if radio is selected
            if (!selected) {
              allValid = false;
              radios.forEach(radio => {
                radio.parentElement.style.border = '1px solid red';
              });
            }
      
            // If "Complete" selected, check date is filled
            if (selected && selected.value === 'Complete' && (!dateInput || !dateInput.value)) {
              allValid = false;
              if (dateInput) {
                dateInput.style.border = '2px solid red';
              }
            }
          });
      
          if (!allValid) {
            e.preventDefault(); // block submission
            formErrorsDiv.style.display = 'block';
            formErrorsDiv.innerHTML = '<div>Please fill out all required fields marked in red.</div>';
            formErrorsDiv.scrollIntoView({ behavior: 'smooth' });
          } else {
            formErrorsDiv.style.display = 'none';
          }
        });
      
        // ✅ Staff ID validation
        staffIdSelect.addEventListener('change', async function () {
          const staffId = this.value;
          if (!staffId) {
            staffNameInput.value = '';
            submitButton.disabled = true;
            submitButton.style.backgroundColor = 'gray';
            return;
          }
      
          try {
            const res = await fetch('/staff/get-staff-details', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ staff_id: staffId })
            });
      
            const data = await res.json();
      
            if (res.ok && data.staff?.staff_name) {
              staffNameInput.value = data.staff.staff_name;
              submitButton.disabled = false;
              submitButton.style.backgroundColor = '';
              errorMessage.style.display = 'none';
            } else {
              staffNameInput.value = '';
              submitButton.disabled = true;
              submitButton.style.backgroundColor = 'gray';
              errorMessage.textContent = 'Staff not found.';
              errorMessage.style.display = 'block';
            }
          } catch (err) {
            console.error('Error fetching staff:', err);
            alert('Server error occurred.');
            staffNameInput.value = '';
            submitButton.disabled = true;
            submitButton.style.backgroundColor = 'gray';
          }
        });
      });
