<script>
  // Function to initialize the canvas drawing behavior
  function initializeSignatureCanvas(canvasId, inputId) {
    const canvas = document.getElementById(canvasId);
    const ctx = canvas.getContext('2d');
    let drawing = false;
    let lastX = 0;
    let lastY = 0;

    // Start drawing when mouse is pressed
    canvas.addEventListener('mousedown', (event) => {
      drawing = true;

      // Get the mouse position relative to the canvas
      const rect = canvas.getBoundingClientRect();
      lastX = event.clientX - rect.left;
      lastY = event.clientY - rect.top;
    });

    // Stop drawing when mouse is released
    canvas.addEventListener('mouseup', () => {
      drawing = false;
    });

    // Draw on canvas when mouse is moved and drawing is true
    canvas.addEventListener('mousemove', (event) => {
      if (drawing) {
        const rect = canvas.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;

        // Draw a line from the last position to the current position
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(x, y);
        ctx.stroke();

        lastX = x; // Update lastX to the current position
        lastY = y; // Update lastY to the current position
      }
    });
    // console.log('one......')

    // document.querySelector('form').addEventListener('submit', (event) => {
    //   console.log('one......1111')
    //   event.preventDefault(); // Prevent form submission for manual handling

    //   const signatureData = canvas.toDataURL(); // Convert canvas to base64 string
    //   document.getElementById(inputId).value = signatureData; // Set the hidden input field
    //   console.log(inputId, signatureData); // Debug: Log the updated input field value

    //   // You can manually submit the form if needed:
    //   document.querySelector('form').submit(); // Uncomment to allow form submission after handling signatures
    // });
    // console.log('two......')
  }

  // Function to handle form submission
  function handleFormSubmit(event) {
    const signatureData = document.getElementById('staff_sign').toDataURL(); // Convert canvas to base64 string
    document.getElementById('staff_sign_input').value = signatureData; // Set the hidden input field
    console.log('Signature data: ', signatureData); // Debugging log
  }

  // Initialize all signature canvases
  window.onload = function() {
    initializeSignatureCanvas('staff_sign', 'staff_sign_input');
    initializeSignatureCanvas('hr_sign', 'hr_sign_input');
    initializeSignatureCanvas('director_sign', 'director_sign_input');
    initializeSignatureCanvas('staff_sign1', 'staff_sign1_input');
    initializeSignatureCanvas('hod_sign1', 'hod_sign1_input');

    // Add submit event listener
    document.querySelector('form').addEventListener('submit', (event) => {
      console.log('one......1111')
      event.preventDefault(); // Prevent form submission for manual handling

      handleFormSubmit(event);

      // You can manually submit the form if needed:
      document.querySelector('form').submit(); // Uncomment to allow form submission after handling signatures
    });
  };
</script>

