<script>
  // Auto-fill name and department based on staff ID
  document.getElementById('staff_id').addEventListener('change', async function () {
    const staffId = this.value;
    if (!staffId) {
      document.getElementById('staff_name').value = '';
      document.getElementById('department').value = '';
      return;
    }
    try {
      const res = await fetch('/staff/get-staff-details', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ staff_id: staffId })
      });
      const data = await res.json();
      if (data.staff) {
        document.getElementById('staff_name').value = data.staff.staff_name || '';
        document.getElementById('current_phone').value = data.staff.staff_phone || '';
        document.getElementById('department').value = data.staff.department || '';
      } else {
        alert('Staff not found');
      }
    } catch (err) {
      console.error('Error fetching staff data:', err);
    }
  });

  // Initialize a signature canvas
  function initializeSignatureCanvas(canvasId) {
    const canvas = document.getElementById(canvasId);
    const ctx = canvas.getContext('2d');
    let drawing = false, lastX = 0, lastY = 0;

    function getPos(e) {
      const rect = canvas.getBoundingClientRect();
      const x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
      const y = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
      return { x, y };
    }

    ['mousedown','touchstart'].forEach(evt =>
      canvas.addEventListener(evt, e => {
        e.preventDefault();
        drawing = true;
        ({ x: lastX, y: lastY } = getPos(e));
      })
    );
    ['mouseup','mouseout','touchend','touchcancel'].forEach(evt =>
      canvas.addEventListener(evt, () => drawing = false)
    );
    ['mousemove','touchmove'].forEach(evt =>
      canvas.addEventListener(evt, e => {
        if (!drawing) return;
        const { x, y } = getPos(e);
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(x, y);
        ctx.stroke();
        lastX = x; lastY = y;
      })
    );
  }

  // Sum block calculation logic (unchanged)
  function updateSum(blockClass, sumClass) {
    const inputs = document.querySelectorAll(`.${blockClass}`);
    let sum = Array.from(inputs).reduce((acc, i) => acc + (parseFloat(i.value) || 0), 0);
    document.querySelector(`.${sumClass}`).textContent = sum;
    document.getElementById(sumClass).value = sum;
    const totalAll = ['block1-sum','block2-sum','block3-sum']
      .reduce((a, id) => a + (parseFloat(document.getElementById(id).value) || 0), 0);
    document.getElementById('block-total').value = totalAll;
    document.getElementById('block-total-display').textContent = totalAll;
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Wire up sum recalculation
    ['block1-input','block2-input','block3-input'].forEach((cls,i) => {
      document.querySelectorAll(`.${cls}`).forEach(inp =>
        inp.addEventListener('input', () => updateSum(cls, `block${i+1}-sum`))
      );
    });
    // Initial sums
    updateSum('block1-input','block1-sum');
    updateSum('block2-input','block2-sum');
    updateSum('block3-input','block3-sum');

    // Initialize all signature canvases
    ['staff_sign','hod_sign','hr_sign','director_sign','staff_sign1','hod_sign1']
      .forEach(initializeSignatureCanvas);

    // Single submit handler
    const form = document.querySelector('form');
    form.addEventListener('submit', e => {
      e.preventDefault();

      // Copy each canvas → hidden input
      ['staff_sign','hod_sign','hr_sign','director_sign','staff_sign1','hod_sign1']
        .forEach(id => {
          const canvas = document.getElementById(id);
          const input  = document.getElementById(`${id}_input`);
          if (canvas && input) {
            input.value = canvas.toDataURL();
          } else {
            console.warn(`Missing #${id} or #${id}_input`);
          }
        });

      // (Optional) inspect in console:
      console.log('staff_sign_input:', document.getElementById('staff_sign_input').value.substring(0,30));

      form.submit();
    });
  });
</script>

