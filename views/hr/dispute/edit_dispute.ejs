<%- include('../../partials/header') %>
  <div class="container">
    <%- include('../../partials/left-panel') %>
      <div class="right-panel">
        <div class="content-area">
          <% if (errorMessages && errorMessages.length> 0) { %>
            <div style="color: red; margin-bottom: 20px;">
              <%= errorMessages[0] %>
            </div>
            <% } %>
              <% if (successMessages && successMessages.length> 0) { %>
                <div style="color: green; margin-bottom: 20px;">
                  <%= successMessages[0] %>
                </div>
                <% } %>

                  <div class="breadcrumbs">
                    <ul>
                      <li><a href="/">Home</a></li>
                      <li><a href="/hr/dispute">Dispute List</a></li>
                      <li>Dispute Management</li>
                    </ul>
                  </div>
                  <div class="form-area">
                    <h2>Staff Dispute Management</h2>
                    <div class="form-box">
                      <form action="/hr/dispute/edit/<%= dispute.id %>" method="POST">
                        <div class="form-row">
                          <div class="form-group">
                            <label for="staff_id">Unique id:</label>
                            <input type="text" id="staff_id_search" name="staff_id_search"
                              value="<%= dispute.StaffDetail ? dispute.StaffDetail.staff_id : dispute.staff_id %>" readonly>

                          </div>
                          <div class="form-group">
                            <label for="staff_name">Employee Name:</label>
                            <input type="text" id="staff_name" name="staff_name"
                              value="<%= dispute.StaffDetail? dispute.StaffDetail.staff_name: dispute.staff_name %>"
                              readonly>
                          </div>
                        </div>
                        <div class="form-row">
                          <div class="form-group">
                            <label for="text">Date:</label>
                            <input type="date" id="doi" name="doi" value="<%= dispute.doi %>">
                            <div class="form-group">
                              <label for="dept">Department</label>
                              <select id="dept" name="dept" required>
                                <option value="">-- Select Department --</option>
                                <% 
                                  const departments = [
                                    'Clinic Manager', 'Speech Therapist', 'OT', 'Physiotherapist', 'ABA',
                                    'ABA Supervisor', 'Psychologist', 'Intern-Speech Therapist', 'Light Vehicle Driver',
                                    'Cleaner', 'Admin', 'Driver', 'Marketing Executive', 'Marketing Manager'
                                  ];
                                  departments.forEach(function(dept) { 
                                %>
                                  <option value="<%= dept %>" <%= dispute.dept === dept ? 'selected' : '' %>><%= dept %></option>
                                <% }) %>
                              </select>
                            </div>
                          </div>
                          <div class="form-row">
                            <div class="form-group">
                              <label for="text">Concern</label>
                              <input type="text" id="concern" name="concern" value="<%= dispute.concern %>">
                            </div>
                            <div class="form-group">
                              <label for="text">Email to forward on </label>
                              <input type="email" id="email_to" name="email_to" value="<%= dispute.email_to %>"
                                required>
                            </div>
                            <div class="form-group">
                              <label for="text">Addressed Date</label>
                              <input type="date" id="addressed_date" name="addressed_date"
                                value="<%= dispute.addressed_date %>">
                            </div>
                          </div>
                          <div class="form-row">
                            <div class="form-group">
                              <label for="text">Response</label>
                              <input type="date" id="response_date" name="response_date"
                                value="<%= dispute.response_date %>">
                            </div>
                            <div class="form-group">
                              <label for="text">Responded by:</label>
                              <input type="text" id="responded_by" name="responded_by"
                                value="<%= dispute.responded_by %>">
                            </div>
                            <div class="form-group">
                              <label for="text">Conclusion:</label>
                              <input type="text" id="conclusion" name="conclusion" value="<%= dispute.conclusion %>">
                            </div>
                          </div>
                        </div>

                        <div class="form-group">
                          <button type="submit">Submit</button>
                          <button type="reset">Reset</button>
                          <p id="errorMessage" style="color: red; display: none;">Please enter a valid 8-character staff
                            ID.</p>
                        </div>
                      </form>
                    </div>
                  </div>
        </div>
      </div>
  </div>
  <script>
    // — SELECTORS —
    const staffIdSearchInput = document.getElementById('staff_id_search');
    const staffNameInput     = document.getElementById('staff_name');
    const submitButton       = document.querySelector('button[type="submit"]');
    const errorMessage       = document.getElementById('errorMessage');
    const form               = submitButton.form;
  
    // — INIT DISABLED STATE —
    setSubmitEnabled(false);
  
    function setSubmitEnabled(enabled) {
      submitButton.disabled = !enabled;
      submitButton.style.backgroundColor = enabled ? '' : 'gray';
    }
  
    // — ON STAFF‑ID CHANGE —
    staffIdSearchInput.addEventListener('input', async () => {
      const id = staffIdSearchInput.value.trim();
  
      // only fetch if exactly 8 chars
      if (id.length === 8) {
        try {
          const res  = await fetch('/staff/get-staff-details', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ staff_id: id })
          });
          const data = await res.json();
  
          if (res.ok && data.staff) {
            // PATCH both fields
            staffIdSearchInput.value = data.staff.staff_id || '';
            staffNameInput.value     = data.staff.staff_name || '';
            errorMessage.style.display = 'none';
            setSubmitEnabled(true);
          } else {
            throw new Error(data.error || 'Not found');
          }
        } catch (e) {
          staffNameInput.value = '';
          errorMessage.textContent = 'Staff ID not found.';
          errorMessage.style.display = 'block';
          setSubmitEnabled(false);
        }
      }
      else {
        // too short/long → reset
        staffNameInput.value = '';
        errorMessage.textContent = 'Staff ID must be exactly 8 characters.';
        errorMessage.style.display = 'block';
        setSubmitEnabled(false);
      }
    });
  
    // — FINAL FORM‑SUBMIT CHECK —
    form.addEventListener('submit', e => {
      if (!staffNameInput.value) {
        e.preventDefault();
        errorMessage.textContent = 'Please resolve the Staff ID before submitting.';
        errorMessage.style.display = 'block';
      }
    });
  </script>
  
